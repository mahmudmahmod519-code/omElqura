<%- include('../partials/header', { title: 'إعادة تعيين كلمة المرور' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div style="max-width: 450px; margin: 2rem auto;">
        <div class="card" style="padding: 3rem;">
            <div style="text-align: center; margin-bottom: 2rem;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-light) 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2rem; color: var(--primary);">
                    <i class="fas fa-lock"></i>
                </div>
                <h2 style="color: var(--primary); margin-bottom: 0.5rem;">إعادة تعيين كلمة المرور</h2>
                <p style="color: var(--text-muted);">أدخل كلمة المرور الجديدة</p>
            </div>

            <div id="alert"></div>

            <form id="resetForm">
                <div class="form-group">
                    <label><i class="fas fa-lock"></i> كلمة المرور الجديدة</label>
                    <input type="password" class="form-control" id="new_password" required placeholder="8 أحرف على الأقل">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-lock"></i> تأكيد كلمة المرور</label>
                    <input type="password" class="form-control" id="confirm_password" required placeholder="أعد إدخال كلمة المرور">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;" id="submitBtn" data-track="reset_password_submit">
                    <span>تحديث كلمة المرور</span>
                </button>
            </form>

            <div style="text-align: center; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #f3f4f6;">
                <p style="color: var(--text-muted);">تذكرت كلمة المرور؟ <a href="/auth/login" style="color: var(--secondary); font-weight: 600;" data-track="login_link">تسجيل الدخول</a></p>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<script>
    document.getElementById('resetForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('submitBtn');
        const alertDiv = document.getElementById('alert');

        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التحديث...';
        btn.disabled = true;

        const data = {
            new_password: document.getElementById('new_password').value,
            confirm_password: document.getElementById('confirm_password').value
        };

        const res = await apiFetch('/auth/api/v1/reset-password/<%= token %>', {
            method: 'POST',
            body: JSON.stringify(data)
        });

        if (res.ok && res.data.status === 'success') {
            alertDiv.innerHTML = '<div class="alert alert-success"><i class="fas fa-check-circle"></i> تم تحديث كلمة المرور بنجاح! جاري التحويل...</div>';
            setTimeout(() => window.location.href = '/auth/login', 1500);
        } else {
            const errors = res.data.errors ? res.data.errors.join('<br>') : (res.data.message || 'حدث خطأ');
            alertDiv.innerHTML = `<div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> ${errors}</div>`;
            btn.innerHTML = '<span>تحديث كلمة المرور</span>';
            btn.disabled = false;
        }
    });
</script>
</body>
</html>
