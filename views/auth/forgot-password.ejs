<%- include('../partials/header', { title: 'نسيت كلمة المرور' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div style="max-width: 450px; margin: 2rem auto;">
        <div class="card" style="padding: 3rem;">
            <div style="text-align: center; margin-bottom: 2rem;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-light) 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2rem; color: var(--primary);">
                    <i class="fas fa-key"></i>
                </div>
                <h2 style="color: var(--primary); margin-bottom: 0.5rem;">نسيت كلمة المرور</h2>
                <p style="color: var(--text-muted);">أدخل بريدك الإلكتروني وسنرسل لك رابط إعادة التعيين</p>
            </div>

            <div id="alert"></div>

            <form id="forgotForm">
                <div class="form-group">
                    <label><i class="fas fa-envelope"></i> البريد الإلكتروني</label>
                    <input type="email" class="form-control" id="email" required placeholder="example@email.com">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;" id="submitBtn" data-track="forgot_password_submit">
                    <span>إرسال رابط الاستعادة</span>
                </button>
            </form>

            <div style="text-align: center; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #f3f4f6;">
                <p style="color: var(--text-muted);">تذكرت كلمة المرور؟ <a href="/auth/login" style="color: var(--secondary); font-weight: 600;" data-track="login_link">تسجيل الدخول</a></p>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<script>
    document.getElementById('forgotForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('submitBtn');
        const alertDiv = document.getElementById('alert');

        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإرسال...';
        btn.disabled = true;

        const email = document.getElementById('email').value;

        const res = await apiFetch('/auth/api/v1/forgot-password', {
            method: 'POST',
            body: JSON.stringify({ email })
        });

        if (res.ok && res.data.status === 'success') {
            alertDiv.innerHTML = '<div class="alert alert-success"><i class="fas fa-check-circle"></i> إذا كان البريد مسجلاً، سيتم إرسال رابط الاستعادة</div>';
            document.getElementById('forgotForm').reset();
        } else {
            alertDiv.innerHTML = `<div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> ${res.data.message || 'حدث خطأ'}</div>`;
        }

        btn.innerHTML = '<span>إرسال رابط الاستعادة</span>';
        btn.disabled = false;
    });
</script>
</body>
</html>
