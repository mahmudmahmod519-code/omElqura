<%- include('../partials/header', { title: 'المتجر' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div class="page-header">
        <h1>المتجر</h1>
        <p>اكتشف مجموعتنا الفاخرة من العطور</p>
    </div>

    <div style="display: grid; grid-template-columns: 280px 1fr; gap: 2rem;">
        <!-- Filter Sidebar -->
        <aside class="filter-sidebar">
            <h3><i class="fas fa-filter"></i> الفلاتر</h3>

            <div class="filter-group">
                <label>بحث</label>
                <input type="text" class="form-control" id="searchInput" placeholder="ابحث عن عطر...">
            </div>

            <div class="filter-group">
                <label>التصنيف</label>
                <select class="form-control" id="categoryFilter">
                    <option value="">الكل</option>
                </select>
            </div>

            <div class="filter-group">
                <label>الماركة</label>
                <select class="form-control" id="brandFilter">
                    <option value="">الكل</option>
                </select>
            </div>

            <div class="filter-group">
                <label>السعر</label>
                <div style="display: flex; gap: 0.5rem;">
                    <input type="number" class="form-control" id="minPrice" placeholder="من">
                    <input type="number" class="form-control" id="maxPrice" placeholder="إلى">
                </div>
            </div>

            <div class="filter-group">
                <label>الترتيب</label>
                <select class="form-control" id="sortSelect">
                    <option value="created_at-DESC">الأحدث</option>
                    <option value="price-ASC">السعر: من الأقل</option>
                    <option value="price-DESC">السعر: من الأعلى</option>
                    <option value="name-ASC">الاسم: أ-ي</option>
                </select>
            </div>

            <button class="btn btn-primary" style="width: 100%;" onclick="applyFilters()" data-track="apply_filters">
                <i class="fas fa-check"></i> تطبيق الفلاتر
            </button>
        </aside>

        <!-- Products Grid -->
        <div>
            <div id="productsGrid" class="grid grid-3">
                <div class="skeleton" style="height: 350px;"></div>
                <div class="skeleton" style="height: 350px;"></div>
                <div class="skeleton" style="height: 350px;"></div>
            </div>
            <div id="pagination" class="pagination"></div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<script>
    let currentPage = 1;
    let filters = {};

    async function loadFilters() {
        const [categoriesRes, brandsRes] = await Promise.all([
            apiFetch('/categories/api/v1'),
            apiFetch('/brands/api/v1')
        ]);

        if (categoriesRes.ok) {
            const select = document.getElementById('categoryFilter');
            categoriesRes.data.data.forEach(cat => {
                select.innerHTML += `<option value="${cat.id}">${cat.name}</option>`;
            });
        }

        if (brandsRes.ok) {
            const select = document.getElementById('brandFilter');
            brandsRes.data.data.forEach(brand => {
                select.innerHTML += `<option value="${brand.id}">${brand.name}</option>`;
            });
        }
    }

    async function loadProducts(page = 1) {
        const grid = document.getElementById('productsGrid');
        grid.innerHTML = '<div class="skeleton" style="height: 350px;"></div>'.repeat(3);

        const params = new URLSearchParams({
            page,
            limit: 12,
            ...filters
        });

        const res = await apiFetch(`/perfumes/api/v1?${params}`);

        if (res.ok && res.data.data.length > 0) {
            grid.innerHTML = res.data.data.map(perfume => `
                <a href="/perfumes/${perfume.id}" class="product-card" data-track="product_card">
                    <img src="${perfume.image_url || '/images/placeholder.jpg'}" alt="${perfume.name}" class="product-card-image">
                    <div class="product-card-body">
                        <h3 class="product-card-title">${perfume.name}</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.5rem;">${perfume.brand?.name || ''}</p>
                        <p class="product-card-price">${formatPrice(perfume.price)}</p>
                        <% if (login) { %>
                            <button class="btn btn-primary" style="width: 100%; margin-top: 1rem;" onclick="event.preventDefault(); addToCart(${perfume.id})" data-track="add_to_cart">
                                <i class="fas fa-shopping-cart"></i> أضف للسلة
                            </button>
                        <% } %>
                    </div>
                </a>
            `).join('');

            const pagination = document.getElementById('pagination');
            let paginationHTML = '';
            for (let i = 1; i <= res.data.pagination.totalPages; i++) {
                paginationHTML += `<a href="#" class="${i === page ? 'active' : ''}" onclick="loadProducts(${i}); return false;">${i}</a>`;
            }
            pagination.innerHTML = paginationHTML;
        } else {
            grid.innerHTML = '<div class="empty-state" style="grid-column: 1/-1;"><div class="empty-state-icon"><i class="fas fa-box-open"></i></div><h3>لا توجد منتجات</h3><p>جرب تغيير الفلاتر</p></div>';
        }
    }

    function applyFilters() {
        const search = document.getElementById('searchInput').value;
        const category = document.getElementById('categoryFilter').value;
        const brand = document.getElementById('brandFilter').value;
        const minPrice = document.getElementById('minPrice').value;
        const maxPrice = document.getElementById('maxPrice').value;
        const sort = document.getElementById('sortSelect').value.split('-');

        filters = {};
        if (search) filters.q = search;
        if (category) filters.category_id = category;
        if (brand) filters.brand_id = brand;
        if (minPrice) filters.min_price = minPrice;
        if (maxPrice) filters.max_price = maxPrice;
        if (sort[0]) filters.sort_by = sort[0];
        if (sort[1]) filters.sort_order = sort[1];

        loadProducts(1);
    }

    async function addToCart(perfumeId) {
        const res = await apiFetch('/orders/api/v1/add-to-cart', {
            method: 'POST',
            body: JSON.stringify({ perfume_id: perfumeId, quantity: 1 })
        });

        if (res.ok) {
            showToast('تمت الإضافة للسلة بنجاح');
        } else {
            showToast(res.data.message || 'حدث خطأ', 'error');
        }
    }

    document.getElementById('searchInput').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') applyFilters();
    });

    loadFilters();
    loadProducts();
</script>
</body>
</html>
