<%- include('../partials/header', { title: 'تفاصيل العطر' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div id="productDetails">
        <div class="skeleton" style="height: 500px;"></div>
    </div>

    <section class="section">
        <h2 class="section-title">التقييمات</h2>
        <div id="reviewsSection">
            <div class="skeleton" style="height: 200px;"></div>
        </div>
    </section>
</main>

<%- include('../partials/footer') %>

<script>
    const perfumeId = '<%= perfumeId %>';

    async function loadProduct() {
        const container = document.getElementById('productDetails');
        const res = await apiFetch(`/perfumes/api/v1/${perfumeId}`);

        if (res.ok) {
            const perfume = res.data.data;
            document.title = perfume.name + ' - عطور أم القرى';

            container.innerHTML = `
                <div class="grid grid-2" style="gap: 3rem;">
                    <div>
                        <img src="${perfume.image_url || '/images/placeholder.jpg'}" alt="${perfume.name}" style="width: 100%; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);">
                    </div>
                    <div>
                        <h1 style="font-size: 2rem; color: var(--primary); margin-bottom: 0.5rem;">${perfume.name}</h1>
                        <p style="color: var(--text-muted); margin-bottom: 1rem;">${perfume.brand?.name || ''} | ${perfume.category?.name || ''}</p>
                        <p style="font-size: 2rem; color: var(--secondary); font-weight: 800; margin-bottom: 1rem;">${formatPrice(perfume.price)}</p>
                        <p style="margin-bottom: 1rem; line-height: 1.8;">${perfume.description || 'لا يوجد وصف'}</p>

                        <div style="margin-bottom: 1rem;">
                            <strong>العائلة العطرية:</strong> ${perfume.fragrance_family || 'غير محدد'}
                        </div>
                        <div style="margin-bottom: 1rem;">
                            <strong>التركيز:</strong> ${perfume.concentration || 'غير محدد'}
                        </div>
                        <div style="margin-bottom: 2rem;">
                            <strong>المخزون:</strong>
                            ${perfume.stock_quantity > 0
                                ? `<span class="badge badge-success">متوفر (${perfume.stock_quantity})</span>`
                                : `<span class="badge badge-error">غير متوفر</span>`}
                        </div>

                        <% if (login) { %>
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <input type="number" id="quantity" value="1" min="1" max="${perfume.stock_quantity}" class="form-control" style="width: 80px;">
                                <button class="btn btn-primary" style="flex: 1;" onclick="addToCart(${perfume.id})" data-track="add_to_cart">
                                    <i class="fas fa-shopping-cart"></i> أضف للسلة
                                </button>
                            </div>
                        <% } else { %>
                            <a href="/auth/login" class="btn btn-primary" style="width: 100%;" data-track="login_to_buy">
                                <i class="fas fa-sign-in-alt"></i> سجل دخولك للشراء
                            </a>
                        <% } %>

                        <a href="/perfumes/${perfume.id}/reviews" style="display: block; text-align: center; margin-top: 1rem; color: var(--secondary); font-weight: 500;" data-track="view_reviews">
                            عرض كل التقييمات <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            `;
        } else {
            container.innerHTML = '<div class="empty-state"><h3>العطر غير موجود</h3><a href="/perfumes" class="btn btn-primary">العودة للمتجر</a></div>';
        }
    }

    async function loadReviews() {
        const container = document.getElementById('reviewsSection');
        const res = await apiFetch(`/reviews/api/v1/perfume/${perfumeId}`);

        if (res.ok && res.data.data.length > 0) {
            const reviews = res.data.data.slice(0, 3);
            container.innerHTML = `
                <div style="text-align: center; margin-bottom: 2rem;">
                    <span style="font-size: 3rem; font-weight: 800; color: var(--primary);">${res.data.summary.avg_rating}</span>
                    <span style="font-size: 1.5rem; color: var(--warning);"><i class="fas fa-star"></i></span>
                    <p style="color: var(--text-muted);">(${res.data.summary.total_reviews} تقييم)</p>
                </div>
                <div class="grid grid-3">
                    ${reviews.map(review => `
                        <div class="card" style="padding: 1.5rem;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <strong>${review.user_name}</strong>
                                <span style="color: var(--warning);"><i class="fas fa-star"></i> ${review.rating}</span>
                            </div>
                            <p style="color: var(--text-muted);">${review.comment || 'لا يوجد تعليق'}</p>
                        </div>
                    `).join('')}
                </div>
            `;
        } else {
            container.innerHTML = '<div class="empty-state"><p>لا توجد تقييمات بعد</p></div>';
        }
    }

    async function addToCart(id) {
        const quantity = parseInt(document.getElementById('quantity').value) || 1;
        const res = await apiFetch('/orders/api/v1/add-to-cart', {
            method: 'POST',
            body: JSON.stringify({ perfume_id: id, quantity })
        });

        if (res.ok) {
            showToast('تمت الإضافة للسلة بنجاح');
        } else {
            showToast(res.data.message || 'حدث خطأ', 'error');
        }
    }

    loadProduct();
    loadReviews();
</script>
</body>
</html>
